# Postgres example
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dash_auto
# OpenAI (optional) - set to use AI agent
OPENAI_API_KEY=
# JWT secret
JWT_SECRET=change-me
# Clé API pour les automatisations externes (ex. Power Automate) sur /automation/*
AUTOMATION_API_KEY=
# Frontend URL for CORS
FRONTEND_URL=http://localhost:3000
